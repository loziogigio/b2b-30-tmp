# vinc-commerce-suite proxy (form submissions, future read-thru endpoints).
# All three are REQUIRED for /api/forms/submit to work; absent → 503.
VINC_SUITE_API_BASE=https://suite.your-domain.com
VINC_SUITE_API_KEY_ID=
VINC_SUITE_API_SECRET=

# Per-owner document broker (/api/profile/document/[model]/[id]).
# Internal overlay base for the documenti-clienti file server. The public
# /documenti-clienti route is closed; the broker fetches files server-side from
# this base after an ownership check. It STRIPS the /documenti-clienti prefix
# (the overlay serves from the file root). Optional locally (falls back to the
# URL stored on the record). Prod: http://vinc-tunnelgw:28000
DOCUMENTI_CLIENTI_BASE=

# Coupons (MyMB) — SEPARATE connection from the ERP. Full URL; credentials may be
# embedded (http://USER:PASS@host:8884/MyMB/Service/web) or supplied via
# COUPON_API_USER / COUPON_API_PASSWORD. The feature is active by default; leave
# COUPON_API_URL unset to disable (the coupon field hides itself).
# COUPON_API_URL=http://USER:PASS@mymb.baseprotection.com:8884/MyMB/Service/web
# COUPON_API_USER=
# COUPON_API_PASSWORD=
